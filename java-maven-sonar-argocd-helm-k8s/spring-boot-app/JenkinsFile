pipeline {
    agent any

    environment {
        // Define your email here
        USER_EMAIL = "vasimvasim6303@gmail.com"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/Vakram/Jenkins-Zero-To-Hero.git'
            }
        }

        stage('Build and Test') {
            steps {
                // Standard Maven build command
                sh 'mvn clean package'
            }
        }

        // --- ADDED STAGE TO FORCE FAILURE FOR TESTING ---
        stage('Quality Gate Check') {
            steps {
                script {
                    // To fail the build intentionally, uncomment the line below:
                    // error("Terminating build due to simulated Quality Gate failure.")
                    echo "Quality Gate passed."
                }
            }
        }

        stage('Static Code Analysis') {
            steps {
                echo "Running SonarQube Analysis..."
            }
        }
        
        // ... (Other stages like Docker Build and ArgoCD Update)
    }

    // --- ADDED POST-BUILD NOTIFICATIONS ---
    post {
        failure {
            mail to: "${env.USER_EMAIL}",
                 subject: "Failed Pipeline: ${currentBuild.fullDisplayName}",
                 body: "Something went wrong with the build. Check the logs here: ${env.BUILD_URL}"
        }
        success {
            echo "Pipeline completed successfully!"
        }
    }
}
